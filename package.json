{
  "name": "hmd2v-xhd-wallet-api",
  "version": "1.2.0",
  "description": "A Typescript implementation of Algorand ARC-52 extended hierarchical deterministic wallets. Forked and maintained by HashMapsData2Value.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/esm/types",
    "build": "yarn build:esm && yarn build:cjs && yarn build:types",
    "test": "yarn test:esm && yarn test:cjs",
    "test:cov": "tsc && tsc-alias -p tsconfig.json -f && node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:cjs": "jest --config jest.cjs.config.cjs",
    "test:esm": "node --experimental-vm-modules node_modules/.bin/jest --config jest.esm.config.mjs",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "HashMapsData2Value",
  "license": "Apache-2.0",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@scure/bip39": "^2.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.2",
    "@types/bn.js": "^5.2.0",
    "@types/jest": "^29.5.5",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^20.7.1",
    "bip32-ed25519": "^0.0.5",
    "hi-base32": "^0.5.1",
    "jest": "^29.7.0",
    "js-sha512": "^0.9.0",
    "libsodium-wrappers-sumo": "^0.7.15",
    "prettier": "^3.2.5",
    "rollup": "^4.52.5",
    "semantic-release": "^24.2.7",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "ajv": "^8.17.1",
    "algo-msgpack-with-bigint": "^2.1.1",
    "big-integer": "^1.6.52",
    "bn.js": "^5.2.2",
    "buffer": "^6.0.3",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react-native-bigint": "^0.0.0",
    "react-native-get-random-values": "^1.11.0"
  },
  "peerDependenciesMeta": {
    "react-native-bigint": {
      "optional": true
    },
    "react-native-get-random-values": {
      "optional": true
    }
  },
  "repository": "git@github.com:HashMapsData2Value/hmd2v-xHD-Wallet-API-ts.git",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): xHD Wallet API \n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": false
        }
      ]
    ],
    "branches": [
      "npm"
    ]
  },
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c"
}
